SEEDING_HOST=127.0.0.1
SEEDING_PORT=4318
# Optional local fixture worker; remains disabled unless explicitly set to 1.
SEEDING_FIXTURE_WORKER=0
SEEDING_FIXTURE_WORKER_INTERVAL_MS=60000
# Optional advisory campaign control cycle. Disabled unless explicitly enabled.
# Minimum interval is 15 minutes; this never dispatches browser/provider actions.
SEEDING_CONTROL_CYCLE_ENABLED=false
SEEDING_CONTROL_CYCLE_MINUTES=0
# Optional read-only public discovery polling. Disabled unless explicitly set.
# Minimum interval is 15 minutes; this observes configured campaign discoverySources only.
SEEDING_DISCOVERY_POLL_MINUTES=0
# Public market/community Listening backend. `http` is the rollback baseline;
# `nodriver` owns a temporary unauthenticated Chrome profile for JS pages.
SEEDING_LISTENING_BACKEND=http
# Optional Python used by the Listening workers. Point to the pinned venv.
# SEEDING_LISTENING_PYTHON=.venv-crawl4ai/bin/python
# Optional autonomous JEV dry-run rehearsal. Disabled unless explicitly set.
# Dry-run-only cycles never submit, consume live grants/windows, or reconcile UNKNOWN executions.
SEEDING_JEV_DRY_RUN_AUTONOMOUS_ENABLED=false
# Optional path to override the bundled local fixture adapter package.
# MARKETING_FIXTURE_ROOT=<local fixture adapter path>
# Optional local CloakBrowser CDP endpoint. Never store credentials or cookies here.
CLOAKBROWSER_CDP_URL=
SEEDING_FIXTURE_CDP_ENABLED=0
# Read-only E2E DOM/network probe; never clicks or publishes.
SEEDING_FIXTURE_E2E_LIVE=0
# Runtime data defaults to $HOME/build-agentic-AI/.agentic/marketing-seeding.
# AGENTIC_ROOT=<local control-plane folder>
# SEEDING_DATA_DIR=<private local state folder>
# SEEDING_AUTO_GTM_FEED_FILE=<local Auto-GTM JSON feed>
# Optional loopback OpenAI-compatible inference adapter. The model is treated
# as healthy only when GET /models lists it; POST /chat/completions stays
# bounded and metadata-only. No remote URL or credential is accepted.
# SEEDING_OI_PROVIDER_ID=local-qwen
# SEEDING_OI_PROVIDER_BASE_URL=http://127.0.0.1:8767/v1
# SEEDING_OI_PROVIDER_MODEL=<model-id>
# SEEDING_R19_PRODUCT_REPO=<local design-os-3d-blender repository>
# SEEDING_R19_MEDIA_PATH=<optional local R19 media file>
# Explicit Camoufox account runtime (metadata only; no credentials/cookies/tokens).
# SEEDING_EXECUTION_SESSION_RESOLVER_MODULE=./src/camoufox-server-resolver.mjs
# SEEDING_EXECUTION_SESSION_PROVIDER=camoufox
# SEEDING_EXECUTION_SESSION_PROFILE_REFERENCE=<exact profile reference>
# SEEDING_EXECUTION_SESSION_AUTHORITY=<non-secret authority reference>
# SEEDING_EXECUTION_SESSION_HOST_ATTESTATION=<fresh JSON attestation with expiry>
# SEEDING_CAMOUFOX_ACCOUNT_REGISTRY_FILE=<sanitized account metadata JSON>
# SEEDING_CAMOUFOX_PROFILE_ROOT=<durable isolated profile directory>
# SEEDING_CAMOUFOX_RUNTIME_PATH=<official camoufox runtime package root>
# SEEDING_CAMOUFOX_EXECUTABLE_PATH=<official camoufox executable>
# SEEDING_CAMOUFOX_RUNTIME_METADATA_PATH=<optional official version.json>
# SEEDING_CAMOUFOX_HEADLESS=true
# Sanitized metadata only; never point this at cookies, browser storage or credentials.
# SEEDING_CAMOUFOX_SESSION_METADATA_FILE=<protected profile>/camoufox-session-runtime.json
